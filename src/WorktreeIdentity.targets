<Project>

    <!--
        Worktree-scoped app identity — APPLICATION.

        WorktreeIdentity.props derives the tags; this file applies them. It lives in .targets
        (imported AFTER the project body) because the suffix must be layered on top of the
        ApplicationId/ApplicationTitle that AppTemplate.csproj sets per AppChannel.

        Full documentation: docs/worktree-identity.md
    -->

    <!-- Identity suffix. ApplicationPublisher is deliberately NOT touched: it must keep matching
         the signing certificate subject used by package-windows.yml. Icons are not touched either
         (UnoIconBackgroundFile must stay constant or Android's @mipmap/icon breaks). -->
    <PropertyGroup Condition="'$(_WorktreeIdentityAllowed)' == 'true'">
        <ApplicationId>$(ApplicationId).$(_WtIdSegment)</ApplicationId>
        <ApplicationTitle>$(ApplicationTitle) ($(_WtLongTag))</ApplicationTitle>
    </PropertyGroup>

    <!--
        Generates AppEnvironment.WorktreeName so the running app can show which worktree it came
        from. AppEnvironment can carry an #if flag but not a string, hence generation.

        The worktree stamp is part of the OUTPUT PATH on purpose. With only
        Inputs="$(MSBuildAllProjects)" the target would be SKIPPED whenever no project file is
        newer than the output — but the name can change without touching any project file
        (git worktree move, or -p:AppWorktreeName=). The stale constant would then survive in obj/
        and the About card would lie about which package is installed.
    -->
    <!-- XamlPreCompile is load-bearing: the WinAppSDK head runs a full C# compile pass under that
         target BEFORE CoreCompile, so hooking only BeforeCompile/CoreCompile builds the Windows
         head without the generated constant and fails with CS0117. -->
    <Target Name="GenerateWorktreeInfo"
            Condition="'$(MSBuildProjectName)' == 'AppTemplate'"
            BeforeTargets="BeforeCompile;CoreCompile;XamlPreCompile">
        <PropertyGroup>
            <_WtStamp Condition="'$(_WorktreeIdentityAllowed)' == 'true'">$(_WtIdSegment)</_WtStamp>
            <_WtStamp Condition="'$(_WtStamp)' == ''">none</_WtStamp>
            <_WorktreeInfoFile>$(IntermediateOutputPath)AppEnvironment.Worktree.$(_WtStamp).g.cs</_WorktreeInfoFile>
            <_WtNameForCode Condition="'$(_WorktreeIdentityAllowed)' == 'true'">$(_WtDisp)</_WtNameForCode>
        </PropertyGroup>

        <WriteLinesToFile File="$(_WorktreeInfoFile)"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true"
                          Lines="// &lt;auto-generated /&gt;;namespace AppTemplate.Infrastructure%3B;;public static partial class AppEnvironment;{;    /// &lt;summary&gt;Git worktree this build came from, or empty for the main checkout.&lt;/summary&gt;;    public const string WorktreeName = &quot;$(_WtNameForCode)&quot;%3B;}" />

        <ItemGroup>
            <Compile Include="$(_WorktreeInfoFile)" />
            <FileWrites Include="$(_WorktreeInfoFile)" />
        </ItemGroup>
    </Target>

    <!--
        Mobile display names.

        The Android launcher label and the iOS home-screen name are LOCALIZED
        (Resources/values*/Strings.xml, Resources/*.lproj/InfoPlist.strings), so a generated
        constant would silently drop Czech. Each locale's file is regenerated instead.

        Two things are appended, and the suffix is computed once here:
          - "Dev" on the Dev channel. docs/versioning.md promises the channel changes the display
            name, but $(ApplicationTitle) never reaches these two platforms - the labels are
            resource-driven - so without this the promise is false on mobile.
          - the worktree short tag, when this build came from a linked worktree.
    -->
    <PropertyGroup>
        <_MobileLabelSuffix Condition="'$(AppChannel)' == 'Dev'">Dev</_MobileLabelSuffix>
        <_MobileLabelSuffix Condition="'$(AppChannel)' == 'Dev' and '$(_WorktreeIdentityAllowed)' == 'true'">Dev [$(_WtShortTag)]</_MobileLabelSuffix>

        <!-- CFBundleName must stay under 16 characters (Apple), and the localized "App Template"
             already costs 12 - so it cannot carry both "Dev" and the tag. It therefore uses a
             fixed short base rather than the localized name, and in a worktree it carries the tag
             INSTEAD of "Dev": a worktree build is always Dev, so the tag is the more useful
             discriminator, and CFBundleDisplayName (what the home screen actually shows) carries
             the full "… Dev [Tag]" anyway. Override IosShortNameBase for your own app. -->
        <IosShortNameBase Condition="'$(IosShortNameBase)' == ''">AppTmpl</IosShortNameBase>
        <_IosShortName Condition="'$(AppChannel)' == 'Dev'">$(IosShortNameBase) Dev</_IosShortName>
        <_IosShortName Condition="'$(_WorktreeIdentityAllowed)' == 'true'">$(IosShortNameBase) [$(_WtShortTag)]</_IosShortName>
    </PropertyGroup>

    <!--
        Android. The regenerated file is written over the copy the SDK has already staged into
        obj/.../res/, because swapping @(AndroidResource) items does NOT work: the SDK fixes its
        resource list before Directory.Build.targets can influence it, so the build succeeds and
        silently ships the untagged label.

        The content is always derived from the PRISTINE tracked source, never from the staged copy,
        which is what makes this idempotent across incremental builds.

        Forward slashes throughout: Android heads build on Linux and macOS too.
    -->
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'AppTemplate' and '$(_MobileLabelSuffix)' != '' and '$(TargetPlatformIdentifier)' == 'android'">
        <_MobileLabelAndroidSrc Include="$(MSBuildProjectDirectory)/Platforms/Android/Resources/**/Strings.xml" />
    </ItemGroup>

    <Target Name="ApplyMobileLabelAndroid"
            Condition="'$(MSBuildProjectName)' == 'AppTemplate' and '$(_MobileLabelSuffix)' != '' and '$(TargetPlatformIdentifier)' == 'android'"
            Outputs="%(_MobileLabelAndroidSrc.RecursiveDir)"
            BeforeTargets="_CompileResources">
        <PropertyGroup>
            <!-- Batched, so %() is scalar here. Outside a batched target RecursiveDir is empty and
                 the resource lands in res/ instead of res/values/, which aapt2 rejects (APT2144). -->
            <_MobileLabelResDest>$(IntermediateOutputPath)res/%(_MobileLabelAndroidSrc.RecursiveDir)strings.xml</_MobileLabelResDest>
        </PropertyGroup>

        <WriteLinesToFile File="$(_MobileLabelResDest)"
                          Lines="$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('%(_MobileLabelAndroidSrc.FullPath)')), '(&lt;string name=&quot;ApplicationName&quot;&gt;)([^&lt;]*)(&lt;/string&gt;)', '$1$2 $(_MobileLabelSuffix)$3'))"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true" />
    </Target>

    <!--
        iOS. CFBundleDisplayName (home screen) keeps the localized name plus the full suffix;
        CFBundleName gets the short fixed form because of Apple's 16-character limit.

        UNVERIFIED - this machine cannot build the iOS head. Note this swaps @(BundleResource)
        items, which is the approach that turned out NOT to work for Android; the iOS bundle
        pipeline runs later so it may well be fine here, but that is an assumption, not a result.
        ContinueOnError keeps a mistake from blocking a local build. Verify on a Mac; if the label
        comes out untagged, write over the staged copy the way ApplyMobileLabelAndroid does.

        Forward slashes throughout: iOS builds only ever run on macOS.
    -->
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'AppTemplate' and '$(_MobileLabelSuffix)' != '' and '$(TargetPlatformIdentifier)' == 'ios'">
        <_MobileLabelIosSrc Include="$(MSBuildProjectDirectory)/Platforms/iOS/Resources/**/InfoPlist.strings" />
    </ItemGroup>

    <Target Name="ApplyMobileLabelIos"
            Condition="'$(MSBuildProjectName)' == 'AppTemplate' and '$(_MobileLabelSuffix)' != '' and '$(TargetPlatformIdentifier)' == 'ios'"
            Outputs="%(_MobileLabelIosSrc.RecursiveDir)"
            BeforeTargets="_CompileAppManifest;CompileAppManifest;_CopyResourcesToBundle">
        <PropertyGroup>
            <_MobileLabelIosSub>%(_MobileLabelIosSrc.RecursiveDir)</_MobileLabelIosSub>
            <_MobileLabelIosDest>$(IntermediateOutputPath)wtres/$(_MobileLabelIosSub)InfoPlist.strings</_MobileLabelIosDest>
        </PropertyGroup>

        <WriteLinesToFile File="$(_MobileLabelIosDest)"
                          ContinueOnError="WarnAndContinue"
                          Lines="$([System.Text.RegularExpressions.Regex]::Replace($([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('%(_MobileLabelIosSrc.FullPath)')), '(&quot;CFBundleDisplayName&quot;\s*=\s*&quot;)([^&quot;]*)(&quot;)', '$1$2 $(_MobileLabelSuffix)$3')), '(&quot;CFBundleName&quot;\s*=\s*&quot;)([^&quot;]*)(&quot;)', '$1$(_IosShortName)$3'))"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true" />

        <ItemGroup>
            <BundleResource Remove="%(_MobileLabelIosSrc.FullPath)" />
            <BundleResource Include="$(_MobileLabelIosDest)" Link="Resources/$(_MobileLabelIosSub)InfoPlist.strings" />
        </ItemGroup>
    </Target>

    <!-- WebAssembly: surface the derived per-worktree dev-server port. The launch profiles are
         tracked files, so they are deliberately not rewritten — per-worktree edits to them are
         exactly the recurring-merge-conflict pattern .claude/rules/docs.md exists to prevent. -->
    <Target Name="ReportWorktreeDevPort"
            Condition="'$(_WorktreeIdentityAllowed)' == 'true' and '$(TargetPlatformIdentifier)' == 'browserwasm'"
            AfterTargets="Build">
        <Message Importance="High"
                 Text="Worktree '$(AppWorktreeName)': serve this head on its own origin with --urls http://localhost:$(_WtDevPort) (port 5000 is reserved for the main checkout)." />
    </Target>

</Project>
