<Project Sdk="Uno.Sdk">
    <PropertyGroup>
        <TargetFrameworks>
            net10.0-android;
            net10.0-ios;
            net10.0-windows10.0.26100;
            net10.0-desktop;
            net10.0-browserwasm;
        </TargetFrameworks>

        <OutputType>Exe</OutputType>
        <UnoSingleProject>true</UnoSingleProject>

        <!-- Application metadata -->
        <ApplicationPublisher>Martin Zikmund</ApplicationPublisher>
        <Description>AppTemplate by Martin Zikmund</Description>
    </PropertyGroup>

    <!-- Channel-specific identity. See docs/versioning.md. -->
    <PropertyGroup Condition="'$(AppChannel)' == 'Prod'">
        <ApplicationTitle>App Template</ApplicationTitle>
        <ApplicationId>dev.mzikmund.apptemplate</ApplicationId>
    </PropertyGroup>

    <PropertyGroup Condition="'$(AppChannel)' == 'Dev'">
        <ApplicationTitle>App Template Dev</ApplicationTitle>
        <ApplicationId>dev.mzikmund.apptemplate.dev</ApplicationId>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Application icon & splash screen adjustments-->
        <!-- Background is shared across channels. The app-icon resource name is derived
             from the background file (Uno maps UnoIcon.Include = UnoIconBackgroundFile),
             so the background must stay constant or Android's @mipmap/icon breaks. -->
        <UnoIconBackgroundFile>Assets/Icons/icon_transparent.svg</UnoIconBackgroundFile>
        <UnoIconBackgroundFile Condition="'$(IsIOS)' == 'true' or '$(IsAndroid)' == 'true'">Assets/Icons/icon.svg</UnoIconBackgroundFile>

        <!-- Dev builds badge the icon and splash below at build time (src/DevAssets.targets). -->

        <UnoIconForegroundScale>1</UnoIconForegroundScale>
        <UnoIconForegroundScale Condition="'$(IsAndroid)' == 'true'">0.6</UnoIconForegroundScale>
        <UnoSplashScreenScale>0.85</UnoSplashScreenScale>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MZikmund.Toolkit.WinUI" />
        <PackageReference Include="sqlite-net-e" />
        <PackageReference Include="SourceGear.sqlite3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AppTemplate.Core\AppTemplate.Core.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(IsWinAppSdk)' == 'true'">
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" PrivateAssets="all" />
    </ItemGroup>

    <!-- Nothing here uses Windows ML (39 MB of natives); an app that adopts it must remove these two. -->
    <!-- Nothing draws with Skia on Windows, but MZikmund.Toolkit.WinUI pulls SkiaSharp.Views.WinUI in. Prune only the
         natives (~230 MB with PDBs); trimming removes the managed side. -->
    <!-- A later Uno.Sdk is meant to turn Skia off on WinAppSDK; revisit then. -->
    <ItemGroup Condition="'$(IsWinAppSdk)' == 'true'">
        <PrunePackageReference Include="Microsoft.WindowsAppSDK.ML" Version="99.0.0" />
        <PrunePackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="99.0.0" />
        <PrunePackageReference Include="SkiaSharp.NativeAssets.Win32" Version="99.0.0" />
        <PrunePackageReference Include="SkiaSharp.NativeAssets.WinUI" Version="99.0.0" />
    </ItemGroup>

    <PropertyGroup Condition="'$(IsWinAppSdk)' == 'true'">
        <!-- Uno.Sdk 7.0.0-dev.179 bundles the runtime into the MSIX; a later SDK defaults this to false for MSIX heads. Drop then. -->
        <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>

        <!-- Full trimming strips what XAML reaches through WinRT: the Localize extension, converters and {Binding} sources. -->
        <TrimMode>partial</TrimMode>
    </PropertyGroup>

    <!-- Trimming Microsoft.WinUI breaks markup extensions: the app dies in InitializeComponent
         ("Markup extension could not provide value", 0xc000027b). Costs ~14.7 MB. -->
    <ItemGroup Condition="'$(IsWinAppSdk)' == 'true'">
        <TrimmerRootAssembly Include="Microsoft.WinUI" />
    </ItemGroup>

    <ItemGroup>
      <Page Update="Resources\DataTemplates.xaml">
        <Generator>MSBuild:Compile</Generator>
      </Page>
    </ItemGroup>
</Project>
