<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Centralized glyph constants for FontIcon usage.

        Keep icon glyph literals in one place instead of scattering raw &#xExxx;
        codes throughout the XAML. Glyph codes below are from the Segoe Fluent
        Icons / Segoe MDL2 Assets font.

        Usage:
        <FontIcon Glyph="{StaticResource ShareIcon}" />
    -->

    <x:String x:Key="ShareIcon">&#xE72D;</x:String>
    <x:String x:Key="SettingsIcon">&#xE713;</x:String>
    <x:String x:Key="AddIcon">&#xE710;</x:String>
    <x:String x:Key="DeleteIcon">&#xE74D;</x:String>
    <x:String x:Key="BackIcon">&#xE72B;</x:String>
    <x:String x:Key="MoreIcon">&#xE712;</x:String>

</ResourceDictionary>
