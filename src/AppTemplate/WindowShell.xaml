<Page
    x:Class="AppTemplate.WindowShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AppTemplate.Controls"
    xmlns:markup="using:AppTemplate.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:not_win="http://uno.ui/not_win"
    xmlns:toolkit="using:Uno.UI.Toolkit"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="not_win">

    <Grid toolkit:VisibleBoundsPadding.PaddingMask="All">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  WinUI title bar (Windows head only; stripped on Uno heads, collapsing this row).  -->
        <win:TitleBar
            x:Name="AppTitleBar"
            Title="{markup:Localize Key=ApplicationName}"
            BackRequested="AppTitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested"
            Subtitle="{x:Bind ViewModel.Title, Mode=OneWay}">
            <win:TitleBar.Resources>
                <!--  Content defaults to Center; Stretch lets the search box fill to MaxWidth.  -->
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </win:TitleBar.Resources>
            <win:TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Icons/icon_foreground.png" />
            </win:TitleBar.IconSource>
            <!--
                RightHeader sits before the system caption buttons and the min drag region, so the
                badge can never overlap the close button the way a corner overlay does.
            -->
            <win:TitleBar.RightHeader>
                <controls:DevChannelBadge Margin="0,0,8,0" VerticalAlignment="Center" />
            </win:TitleBar.RightHeader>
            <win:TitleBar.Content>
                <!--  Plain, non-interactive placeholder. Apps wire up search here.  -->
                <AutoSuggestBox
                    MaxWidth="580"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    IsEnabled="False"
                    QueryIcon="Find" />
            </win:TitleBar.Content>
        </win:TitleBar>

        <!--  NavigationView  -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            not_win:IsBackButtonVisible="Auto"
            not_win:IsPaneToggleButtonVisible="True"
            win:IsBackButtonVisible="Collapsed"
            win:IsPaneToggleButtonVisible="False"
            BackRequested="NavView_BackRequested"
            CompactModeThresholdWidth="640"
            CompactPaneLength="48"
            ExpandedModeThresholdWidth="1008"
            IsBackEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
            Loaded="NavView_Loaded"
            OpenPaneLength="280"
            PaneDisplayMode="Auto"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="MainNavItem"
                    Content="{markup:Localize Key=Home}"
                    Tag="Main">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="InnerFrame" />
        </NavigationView>

        <!--
            Dev-channel indicator for heads with no WinUI TitleBar (the Windows head hosts the
            same control in TitleBar.RightHeader above). The not_win wrapper is mc:Ignorable, so
            this whole subtree is dropped on Windows.
        -->
        <not_win:Border
            Grid.RowSpan="2"
            Margin="0,8,8,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
            <controls:DevChannelBadge />
        </not_win:Border>
    </Grid>
</Page>
