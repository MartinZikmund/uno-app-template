<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<!-- The Mac App Store only takes sandboxed apps -->
		<key>com.apple.security.app-sandbox</key>
		<true/>

		<!-- The .NET runtime compiles code at run time -->
		<key>com.apple.security.cs.allow-jit</key>
		<true/>
		<!--#if (http)-->

		<!-- Outgoing connections, for the HTTP client -->
		<key>com.apple.security.network.client</key>
		<true/>
		<!--#endif-->

		<!--
		Add what your app uses, and nothing more: App Review asks about each one.
		Open and save panels (FileOpenPicker, FileSavePicker):
		<key>com.apple.security.files.user-selected.read-write</key>
		<true/>
		-->
	</dict>
</plist>
