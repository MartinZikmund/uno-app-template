<?xml version="1.0" encoding="utf-8" ?>
<!--
	Android 12+ splash icon: the logo alone on a transparent background. Resizetizer's uno_splash_image
	layers the splash colour under it, which shows as a disc whenever the window background differs.
	splash_screen is the PNG Resizetizer renders from UnoSplashScreenFile, so rename the two together.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:width="108dp" android:height="108dp" android:gravity="center">
		<bitmap android:gravity="fill" android:src="@drawable/splash_screen" android:mipMap="true" android:tileMode="disabled" />
	</item>
</layer-list>
