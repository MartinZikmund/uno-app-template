<Project Sdk="MSTest.Sdk">

  <!--
    Packs the real template, generates apps from it and checks the output. Build scenarios compile
    the generated apps and are slow: filter with TestCategory=Build / !=Build.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Spectre.Console.Testing" Version="0.57.2" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- UpgradeTests run the real tool, so its private patching logic gets exercised as users hit it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\tools\Wizard.Cli\MZikmund.UnoApp.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.CodeCoverage" Version="18.7.0" />
    <PackageReference Update="Microsoft.Testing.Extensions.TrxReport" Version="2.2.3" />
    <PackageReference Update="MSTest.TestAdapter" Version="4.2.3" />
    <PackageReference Update="MSTest.TestFramework" Version="4.2.3" />
  </ItemGroup>

</Project>
