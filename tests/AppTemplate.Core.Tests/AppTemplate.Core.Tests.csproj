<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Mirror trimmed apps: reflection-based System.Text.Json must fail in tests too. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- UNOB0029 does not recognize MSTest.Sdk (MTP) test projects as test projects. -->
    <UnoDisableUNOB0029Validation>true</UnoDisableUNOB0029Validation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AppTemplate.Core\AppTemplate.Core.csproj" />
  </ItemGroup>

  <!-- Assertion + mocking stack prescribed by .claude/rules/testing.md.
       Versions match src/Directory.Packages.props (tests live outside the CPM scope). -->
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.CodeCoverage" Version="18.7.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.TrxReport" Version="2.2.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.TestAdapter" Version="4.2.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.TestFramework" Version="4.2.3" />
  </ItemGroup>

</Project>
