<Project Sdk="MSTest.Sdk">

  <!--
    Tests for the TEMPLATE's own dev tooling (Dev assets, worktree identity), not for the app. Apps created from the
    template delete this project along with .github/workflows/template-selftest.yml. App tests belong in
    AppTemplate.Core.Tests.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- UNOB0029 does not recognize MSTest.Sdk (MTP) test projects as test projects. -->
    <UnoDisableUNOB0029Validation>true</UnoDisableUNOB0029Validation>
  </PropertyGroup>

  <!-- The worktree label on the About page (SettingsViewModel.WorktreeLabel). -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\AppTemplate.Core\AppTemplate.Core.csproj" />
  </ItemGroup>

  <!-- The wizard's shared logic (tools/Wizard.Core). -->
  <ItemGroup>
    <ProjectReference Include="..\..\tools\Wizard.Core\Wizard.Core.csproj" />
  </ItemGroup>

  <!-- The Dev-asset composer is an MSBuild inline task (src/DevAssets.targets); compile the same source to test it. -->
  <ItemGroup>
    <Compile Include="..\..\src\DevAssets.Task.cs" Link="DevAssets\DevAssets.Task.cs" />
  </ItemGroup>

  <!-- Versions match tests/AppTemplate.Core.Tests (tests live outside the CPM scope). -->
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <!-- 18.9.x: the last MSBuild line that ships a net10.0 build (18.10 moved to net11.0). -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.12.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.CodeCoverage" Version="18.7.0" />
    <PackageReference Update="Microsoft.Testing.Extensions.TrxReport" Version="2.2.3" />
    <PackageReference Update="MSTest.TestAdapter" Version="4.2.3" />
    <PackageReference Update="MSTest.TestFramework" Version="4.2.3" />
  </ItemGroup>

</Project>
